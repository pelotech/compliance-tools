#!/bin/bash
#
# ClamAV Suite uninstaller.
#
# Generated by build-clamav-suite.sh and installed to
# __SUPPORT_DIR__/uninstall.sh so the suite can be removed without the
# build repo, and without MDM -- unassigning a package from a Blueprint does not
# uninstall it, because macOS flat packages have no removal semantics at all.
#
# Usage:
#   sudo __SUPPORT_DIR__/uninstall.sh [--dry-run] [--keep-user-data]
#
set -uo pipefail

SUITE_VERSION="__SUITE_VERSION__"
GUI_APP="/Applications/__GUI_APP_NAME__"
GUI_BUNDLE_ID="__BUNDLE_ID__"
CLAMAV_DIR="__CLAMAV_DIR__"
DAEMON_LABEL="__DAEMON_LABEL__"
SUPPORT_DIR="__SUPPORT_DIR__"
RECEIPTS="__RECEIPTS__"
SELF_PATH="__SUPPORT_DIR__/uninstall.sh"

DRY=0
KEEP_USER_DATA=0
REMOVED=0
FAILED=0

# Relocation happens FIRST, before a single argument is consumed.
#
# This script lives inside a directory it is about to delete, and bash reads
# scripts incrementally rather than all at once, so deleting our own file
# mid-run can truncate execution partway through. The fix is to copy ourselves
# to a temp file and re-exec.
#
# The ordering matters and must survive future edits. The parse loop below
# consumes "$@" via shift, so relocating after it would re-exec with an EMPTY
# argument list -- silently resetting DRY to 0 and turning `--dry-run` into a
# real uninstall, which is the one invocation a cautious admin reaches for
# first. Relocating before any parsing leaves no parsed state to carry across
# the re-exec at all.
if [ -z "${CLAMAV_UNINSTALL_RELOCATED:-}" ]; then
  case "$0" in
    "$SUPPORT_DIR"/*|"$CLAMAV_DIR"/*)
      _tmp="$(mktemp -t clamav-suite-uninstall)" || exit 1
      cat "$0" > "$_tmp"
      chmod 700 "$_tmp"
      export CLAMAV_UNINSTALL_RELOCATED=1
      exec /bin/bash "$_tmp" "$@"
      ;;
  esac
else
  # We are the relocated copy; clean ourselves up on the way out.
  trap 'rm -f "$0"' EXIT
fi

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)        DRY=1 ;;
    --keep-user-data) KEEP_USER_DATA=1 ;;
    -h|--help)
      printf 'usage: sudo %s [--dry-run] [--keep-user-data]\n\n' "$SELF_PATH"
      printf '  --dry-run         report what would be removed, change nothing\n'
      printf '  --keep-user-data  leave per-user GUI data, including quarantine\n'
      exit 0 ;;
    *) printf 'unknown argument: %s\n' "$1" >&2; exit 2 ;;
  esac
  shift
done

if [ "$(id -u)" -ne 0 ]; then
  printf 'error: must run as root:\n  sudo %s\n' "$SELF_PATH" >&2
  exit 1
fi

say() { printf '%s\n' "$*"; }

# Every removal is best-effort and reported. A missing piece is normal (partial
# install, previous run, or a component the fleet never received) and must not
# abort the rest of the teardown.
remove() {
  local p="$1"

  # Every path here is built from build-time substitutions, so a bad or empty
  # placeholder would aim `rm -rf` at something catastrophic. Refuse anything
  # that is not safely deep and specific rather than trusting the caller.
  case "$p" in
    ''|'/'|/Applications|/Users|/Library|/usr|/usr/local|/usr/local/share|/var|/var/log)
      say "  REFUSED        $p (too broad to remove)"
      FAILED=$((FAILED + 1))
      return 0 ;;
    /*/*) : ;;
    *)
      say "  REFUSED        $p (not an absolute, sufficiently specific path)"
      FAILED=$((FAILED + 1))
      return 0 ;;
  esac

  if [ ! -e "$p" ] && [ ! -L "$p" ]; then
    return 0
  fi
  if [ "$DRY" -eq 1 ]; then
    say "  would remove   $p"
    return 0
  fi
  if rm -rf "$p" 2>/dev/null; then
    say "  removed        $p"
    REMOVED=$((REMOVED + 1))
  else
    say "  FAILED         $p"
    FAILED=$((FAILED + 1))
  fi
}

run() {
  if [ "$DRY" -eq 1 ]; then
    say "  would run      $*"
    return 0
  fi
  "$@" >/dev/null 2>&1 || true
}

say "ClamAV Suite ${SUITE_VERSION} uninstaller"
[ "$DRY" -eq 1 ] && say "(dry run -- nothing will be changed)"
say ""

# 1. Stop the updater before its plist goes away. Skipping this leaves the job
#    loaded until reboot, firing freshclam against a half-deleted tree.
say "stopping the freshclam daemon"
run launchctl bootout "system/${DAEMON_LABEL}"

# 2. Stop anything still holding the binaries open. pkill matches across users,
#    which is what we want for a machine-wide uninstall.
say "stopping running ClamAV processes"
for proc in clamav-gui clamd freshclam clamscan clamdscan; do
  run pkill -x "$proc"
done

# 3. CLI symlinks in /usr/local/bin. Removed before the tree they point into, and
#    only when they actually point there -- a link someone else owns, or a real
#    binary from another ClamAV installation, is left alone. Skipping this would
#    leave dangling symlinks on the PATH that fail confusingly.
say ""
say "removing CLI symlinks"
for tool in clamscan clamdscan clamdtop clamconf clambc clamsubmit freshclam sigtool clamd; do
  link="/usr/local/bin/${tool}"
  [ -L "$link" ] || continue
  case "$(readlink "$link")" in
    "${CLAMAV_DIR}"/*) remove "$link" ;;
    *) say "  skipped        $link (points outside ${CLAMAV_DIR})" ;;
  esac
done

# 4. Payload roots. /usr/local/clamav belongs exclusively to ClamAV, so removing
#    the whole tree also clears the definition database (~250 MB) and the
#    freshclam.conf / clamd.conf that postinstall seeded from the .sample files
#    -- none of which appear in any package receipt.
say ""
say "removing installed files"
remove "$GUI_APP"
remove "$CLAMAV_DIR"
remove "/Library/LaunchDaemons/${DAEMON_LABEL}.plist"

# 5. Logs, also untracked by any receipt.
remove /var/log/freshclam.log
remove /var/log/freshclam.err

# 6. Per-user GUI state. Not covered by any receipt and not under /Applications,
#    so it survives an otherwise complete uninstall and silently repopulates the
#    app's history and settings on reinstall.
if [ "$KEEP_USER_DATA" -eq 1 ]; then
  say ""
  say "keeping per-user GUI data (--keep-user-data)"
else
  say ""
  say "removing per-user GUI data"
  for home in /Users/*; do
    [ -d "$home" ] || continue
    case "$(basename "$home")" in Shared|Guest|.localized) continue ;; esac
    remove "$home/Library/Application Support/${GUI_BUNDLE_ID}"
    remove "$home/Library/Caches/${GUI_BUNDLE_ID}"
    remove "$home/Library/WebKit/${GUI_BUNDLE_ID}"
    remove "$home/Library/HTTPStorages/${GUI_BUNDLE_ID}"
    remove "$home/Library/HTTPStorages/${GUI_BUNDLE_ID}.binarycookies"
    remove "$home/Library/Preferences/${GUI_BUNDLE_ID}.plist"
    remove "$home/Library/Saved Application State/${GUI_BUNDLE_ID}.savedState"
  done
fi

# 7. The Full Disk Access grant is keyed to the bundle ID and outlives the app,
#    so it silently re-applies on reinstall. Fails harmlessly if never granted.
say ""
say "clearing the Full Disk Access grant"
run tccutil reset SystemPolicyAllFiles "$GUI_BUNDLE_ID"

# 8. Receipts last. pkgutil --forget only discards receipt data -- it removes no
#    files -- so doing it earlier would throw away the only record of what was
#    installed while the files were still on disk.
say ""
say "discarding package receipts"
for id in $RECEIPTS; do
  if pkgutil --pkgs | grep -qx "$id"; then
    if [ "$DRY" -eq 1 ]; then
      say "  would forget   $id"
    elif pkgutil --forget "$id" >/dev/null 2>&1; then
      say "  forgot         $id"
    else
      say "  FAILED         $id"
      FAILED=$((FAILED + 1))
    fi
  else
    say "  not present    $id"
  fi
done

# 9. The support directory holds this script. Safe because we re-exec'd from a
#    temp copy above.
say ""
say "removing the support directory"
remove "$SUPPORT_DIR"

say ""
if [ "$DRY" -eq 1 ]; then
  say "Dry run complete. Re-run without --dry-run to apply."
elif [ "$FAILED" -gt 0 ]; then
  say "Uninstall finished with ${FAILED} failure(s); ${REMOVED} path(s) removed."
  say "Check the FAILED lines above -- SIP or a running process may hold them."
  exit 1
else
  say "Uninstall complete. ${REMOVED} path(s) removed."
  say "Remove the package from its Blueprint too, or MDM may reinstall it."
fi
