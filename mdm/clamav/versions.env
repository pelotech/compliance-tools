# Pinned upstream artifacts for the ClamAV suite package.
#
# Renovate bumps the *_TAG values; the hashes are then recomputed by CI
# (.github/workflows/pr.yml runs `build-clamav-suite.sh --rehash`).
#
# The tag prefixes ("clamav-", "v") deliberately live outside Renovate's capture
# groups so it writes back a correctly formatted tag. See renovate.json.
#
# To bump by hand:  ./build-clamav-suite.sh --refresh   (resolve latest + rehash)
# To fix hashes:    ./build-clamav-suite.sh --rehash    (keep tags, rehash only)

# https://github.com/Cisco-Talos/clamav/releases
# Ships one universal macOS distribution pkg plus a detached GPG signature.
CLAMAV_TAG=clamav-1.5.3
CLAMAV_SHA256=3d943c37fb7b0ce6b7b79c0422bf39eb014ffb81fa4aa41fa9aa11303ee5acf5

# https://github.com/ArsenTech/clamav-gui/releases
# No macOS pkg upstream. This fleet is Apple Silicon only, so only the arm64
# .app.tar.gz is pulled -- it needs no disk image to mount, and its bundle was
# verified byte-identical to the one in the .dmg. The vendor ships no signature
# we can check, so this hash is the only integrity control on it.
GUI_TAG=v1.0.6
GUI_ARM64_SHA256=69d040b6ad97bf7603e165d3ab89394457f776ffc1eccff0134bef802981605a
